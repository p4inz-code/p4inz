# P4inz environment configuration
# Never place real secrets in this file.

# Structured logging (Milestone 51). Standard `tracing`/`env_logger`
# syntax, e.g. "info", "debug", "p4inz_api=debug,info".
RUST_LOG=info
P4INZ_ENV=development

DATABASE_URL=

DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

GITHUB_TOKEN=
# Comma-separated "owner/repo" list synchronized on a schedule (Milestone 35).
GITHUB_REPOSITORIES=

AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# HTTP API (Milestone 37). Defaults to port 8080 if unset.
API_PORT=
# Comma-separated allowed CORS origins, e.g. the website's origin. Empty
# means no cross-origin browser request is permitted. When P4INZ_ENV is
# "production", every origin must be https:// (Milestone 56).
API_ALLOWED_ORIGINS=

# Web/admin authentication via "Sign in with Discord" (Milestone 40).
# All three must be set for /v1/auth/* to be mounted; DISCORD_APPLICATION_ID
# above doubles as the OAuth client_id.
DISCORD_CLIENT_SECRET=
# When P4INZ_ENV is "production", must be https:// (Milestone 56).
AUTH_REDIRECT_URI=
# Signs session tokens (HMAC-SHA256) — must be at least 32 characters,
# in every environment, not just production (Milestone 56). Generate one
# with: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Comma-separated Discord user ids granted admin API access (Milestone 41).
ADMIN_USER_IDS=
